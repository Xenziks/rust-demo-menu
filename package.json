{
  "name": "rust-demo-menu",
  "version": "1.0.0",
  "description": "Демонстрационное меню Rust",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.rustdemomenu",
    "productName": "Rust",
    "asar": true,
    "files": ["main.js", "index.html", "package.json"],
    "directories": {"output": "dist"},
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}]
    }
  }
}
